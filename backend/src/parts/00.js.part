/**
 * GenKey - Cloudflare Worker Backend
 * Supports Passwordless + Classic 2FA with continuous risk
 */
import {
  generateRegistrationOptions,
  verifyRegistrationResponse,
  generateAuthenticationOptions,
  verifyAuthenticationResponse
} from '@simplewebauthn/server';

// Simple UUID
function uuid() {
  return crypto.randomUUID();
}

// Password hashing (PBKDF2 via Web Crypto)
async function hashPassword(password, salt) {
  const enc = new TextEncoder();
  const keyMaterial = await crypto.subtle.importKey(
    'raw', enc.encode(password), 'PBKDF2', false, ['deriveBits']
  );
  const bits = await crypto.subtle.deriveBits(
    { name: 'PBKDF2', salt: enc.encode(salt), iterations: 100000, hash: 'SHA-512' },
    keyMaterial, 512
  );
  return [...new Uint8Array(bits)].map(b => b.toString(16).padStart(2, '0')).join('');
}

function generateSalt() {
  const arr = new Uint8Array(16);
  crypto.getRandomValues(arr);
  return [...arr].map(b => b.toString(16).padStart(2, '0')).join('');
}

// Risk engine
function computeRisk(signals, previous = {}) {
  let score = 0;
  const reasons = [];

  if (previous.last_ip && signals.ip && previous.last_ip !== signals.ip) {
    score += 25; reasons.push('IP address changed');
  }
  if (previous.last_device_fp && signals.deviceFp && previous.last_device_fp !== signals.deviceFp) {
    score += 35; reasons.push('Device fingerprint mismatch');
  }
  if (previous.last_check) {
    const deltaMin = (Date.now() - previous.last_check) / 60000;
    if (deltaMin > 30) { score += 20; reasons.push('Long idle period'); }
  }
  if (signals.behaviorScore !== undefined) {
    const penalty = Math.round(signals.behaviorScore * 40);
    score += penalty;
    if (penalty > 15) reasons.push('Behavioral anomaly detected');
  }
  if (!previous.last_device_fp && signals.deviceFp) {
    score += 15; reasons.push('New device');
  }
  const hour = new Date().getHours();
  if (hour >= 2 && hour <= 5) { score += 10; reasons.push('Unusual hour'); }

  score = Math.min(100, Math.max(0, score));
  let level = 'low';
  if (score >= 60) level = 'high';
  else if (score >= 30) level = 'medium';

  return { score, level, reasons, requireStepUp: score >= 60 };
}

// CORS helper
function corsHeaders(origin) {
  return {
    'Access-Control-Allow-Origin': origin || '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    'Access-Control-Allow-Credentials': 'true'
  };
}

function json(data, status = 200, origin) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { 'Content-Type': 'application/json', ...corsHeaders(origin) }
  });
}

